<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion admin — Résidence Habili Saly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Mulish:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--sable);
            padding: 24px;
        }
        .admin-carte {
            background: var(--blanc);
            border-radius: var(--rayon);
            box-shadow: var(--ombre);
            padding: 40px;
            width: 100%;
            max-width: 380px;
        }
        .admin-carte h1 {
            font-family: var(--police-titres);
            font-size: 1.5rem;
            color: var(--encre);
            margin: 0 0 24px;
            text-align: center;
        }
        .admin-champ {
            margin-bottom: 18px;
        }
        .admin-champ label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--encre);
        }
        .admin-champ input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--sable-fonce);
            border-radius: var(--rayon-petit);
            font-family: var(--police-texte);
            font-size: 1rem;
        }
        .admin-champ-mdp {
            position: relative;
        }
        .admin-champ-mdp input {
            padding-right: 44px;
        }
        .admin-carte .admin-toggle-mdp {
            position: absolute;
            right: 6px;
            top: 32px;
            width: 30px !important;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: none !important;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            padding: 0;
            color: var(--encre);
        }
        .admin-carte .admin-toggle-mdp:hover {
            background: var(--sable) !important;
            color: var(--terracotta);
        }
        .admin-toggle-mdp svg { width: 18px; height: 18px; }
        .admin-erreur {
            background: #fbe9e5;
            color: var(--erreur);
            padding: 12px 14px;
            border-radius: var(--rayon-petit);
            margin-bottom: 18px;
            font-size: 0.9rem;
        }
        .admin-carte button {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: var(--rayon-petit);
            background: var(--terracotta);
            color: var(--blanc);
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
        }
        .admin-carte button:hover { background: var(--terracotta-fonce); }
    </style>
</head>
<body>
<div class="admin-page">
    <div class="admin-carte">
        <h1>Espace administrateur</h1>
        <% if (erreur) { %>
            <div class="admin-erreur"><%= erreur %></div>
        <% } %>
        <form method="POST" action="/admin/connexion">
            <div class="admin-champ admin-champ-mdp">
                <label for="motDePasse">Mot de passe</label>
                <input type="password" id="motDePasse" name="motDePasse" required autofocus>
                <button type="button" class="admin-toggle-mdp" id="toggleMdp" aria-label="Afficher le mot de passe">
                    <svg id="iconeOeilOuvert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="iconeOeilFerme" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                        <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.6 18.6 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
            <button type="submit">Se connecter</button>
        </form>
    </div>
</div>
<script>
    const champMdp = document.getElementById('motDePasse');
    const boutonToggle = document.getElementById('toggleMdp');
    const oeilOuvert = document.getElementById('iconeOeilOuvert');
    const oeilFerme = document.getElementById('iconeOeilFerme');
    boutonToggle.addEventListener('click', function () {
        const estMasque = champMdp.type === 'password';
        champMdp.type = estMasque ? 'text' : 'password';
        oeilOuvert.style.display = estMasque ? 'none' : 'block';
        oeilFerme.style.display = estMasque ? 'block' : 'none';
        boutonToggle.setAttribute('aria-label', estMasque ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
    });
</script>
</body>
</html>
