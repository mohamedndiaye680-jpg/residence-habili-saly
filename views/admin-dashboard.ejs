<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><% const nonTraites = messages.filter(m => !m.traite).length; %><%= nonTraites > 0 ? '(' + nonTraites + ') ' : '' %>Réservations — Résidence Habili Saly</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Mulish:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background: var(--sable); }
        .admin-entete {
            background: var(--blanc);
            box-shadow: var(--ombre-legere);
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .admin-entete h1 {
            font-family: var(--police-titres);
            font-size: 1.4rem;
            color: var(--encre);
            margin: 0;
        }
        .admin-entete form button {
            background: none;
            border: 1px solid var(--sable-fonce);
            border-radius: var(--rayon-petit);
            padding: 8px 16px;
            cursor: pointer;
            color: var(--encre-doux);
        }
        .admin-corps {
            max-width: var(--largeur-max);
            margin: 32px auto;
            padding: 0 24px;
        }
        .admin-carte-demande {
            background: var(--blanc);
            border-radius: var(--rayon);
            box-shadow: var(--ombre-legere);
            padding: 20px 24px;
            margin-bottom: 16px;
            border-left: 4px solid var(--terracotta);
        }
        .admin-carte-demande.traite {
            border-left-color: var(--succes);
            opacity: 0.7;
        }
        .admin-carte-demande__entete {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 10px;
        }
        .admin-carte-demande__nom {
            font-family: var(--police-titres);
            font-size: 1.2rem;
            color: var(--encre);
        }
        .admin-carte-demande__date {
            color: var(--encre-doux);
            font-size: 0.85rem;
        }
        .admin-carte-demande__details {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }
        .admin-carte-demande__details strong { color: var(--ocean); }
        .admin-carte-demande__message {
            background: var(--sable);
            border-radius: var(--rayon-petit);
            padding: 12px 14px;
            white-space: pre-wrap;
            font-size: 0.95rem;
            margin-bottom: 12px;
        }
        .admin-vide {
            text-align: center;
            color: var(--encre-doux);
            padding: 60px 20px;
        }
        .admin-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            background: var(--terracotta-clair);
            color: var(--blanc);
        }
        .admin-badge.traite { background: var(--succes); }
        .admin-entete__titre {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .admin-cloche {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .admin-cloche svg {
            width: 24px;
            height: 24px;
            color: var(--encre);
        }
        .admin-cloche-compteur {
            position: absolute;
            top: -8px;
            right: -10px;
            background: var(--terracotta);
            color: var(--blanc);
            font-size: 0.7rem;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
        }
        .admin-toggle-form button {
            border: 1px solid var(--sable-fonce);
            background: var(--blanc);
            border-radius: var(--rayon-petit);
            padding: 6px 14px;
            cursor: pointer;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
<div class="admin-entete">
    <div class="admin-entete__titre">
        <h1>Demandes de réservation (<%= messages.length %>)</h1>
        <% if (nonTraites > 0) { %>
            <span class="admin-cloche" title="<%= nonTraites %> demande(s) non traitée(s)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span class="admin-cloche-compteur"><%= nonTraites %></span>
            </span>
        <% } %>
    </div>
    <form method="POST" action="/admin/deconnexion">
        <button type="submit">Se déconnecter</button>
    </form>
</div>

<div class="admin-corps">
    <% if (erreur) { %>
        <div class="admin-vide" style="background:#fbe9e5; color:#8a3b2b; border-radius:8px; padding:14px; text-align:left; margin-bottom:16px;">
            <%= erreur %>
        </div>
    <% } %>
    <% if (messages.length === 0) { %>
        <div class="admin-vide">Aucune demande reçue pour le moment.</div>
    <% } else { %>
        <% messages.forEach(function(m) { %>
            <% const id = m._id || m.id; %>
            <div class="admin-carte-demande <%= m.traite ? 'traite' : '' %>">
                <div class="admin-carte-demande__entete">
                    <div>
                        <span class="admin-carte-demande__nom"><%= m.nom %></span>
                        <span class="admin-badge <%= m.traite ? 'traite' : '' %>">
                            <%= m.traite ? 'Traité' : 'Nouveau' %>
                        </span>
                    </div>
                    <span class="admin-carte-demande__date">
                        <%= new Date(m.dateReception).toLocaleString('fr-FR') %>
                    </span>
                </div>
                <div class="admin-carte-demande__details">
                    <span><strong>Téléphone :</strong> <%= m.telephone %></span>
                    <% if (m.email) { %><span><strong>Email :</strong> <%= m.email %></span><% } %>
                    <span><strong>Hébergement :</strong> <%= m.typeHebergement %></span>
                    <% if (m.dateArrivee && m.dateDepart) { %>
                        <span><strong>Séjour :</strong> <%= new Date(m.dateArrivee).toLocaleDateString('fr-FR') %> → <%= new Date(m.dateDepart).toLocaleDateString('fr-FR') %></span>
                    <% } %>
                </div>
                <div class="admin-carte-demande__message"><%= m.message %></div>
                <form class="admin-toggle-form" method="POST" action="/admin/messages/<%= id %>/traite">
                    <input type="hidden" name="traite" value="<%= m.traite ? '0' : '1' %>">
                    <button type="submit">
                        <%= m.traite ? 'Marquer comme non traité' : 'Marquer comme traité' %>
                    </button>
                </form>
                <form class="admin-toggle-form" method="POST" action="/admin/messages/<%= id %>/annuler" style="margin-top:6px;">
                    <input type="hidden" name="annulee" value="<%= m.annulee ? '0' : '1' %>">
                    <button type="submit">
                        <%= m.annulee ? 'Réactiver ces dates' : 'Annuler et libérer ces dates' %>
                    </button>
                </form>
            </div>
        <% }); %>
    <% } %>
</div>
</body>
</html>
