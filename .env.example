# Copiez ce fichier en .env pour le développement local (ne jamais commiter .env)
# Sur Render, ces mêmes variables se configurent dans Settings > Environment.

# URL de connexion à MongoDB Atlas (base de données gratuite)
MONGODB_URI=

# Compte Gmail utilisé pour envoyer et recevoir les notifications de réservation
GMAIL_USER=residencehabilisaly@gmail.com
# Mot de passe d'application Gmail (PAS le mot de passe normal du compte)
GMAIL_PASS=

# Mot de passe pour accéder à la page /admin
ADMIN_PASSWORD=

# Clé secrète utilisée pour sécuriser les sessions (une phrase aléatoire suffit)
SESSION_SECRET=change-moi-avec-une-phrase-aleatoire

# URL publique du site (utilisée dans l'email de notification)
SITE_URL=https://residence-habili-saly.onrender.com
